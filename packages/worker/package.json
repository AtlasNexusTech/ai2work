{
  "name": "@atlasnexus/aijobs-worker",
  "version": "0.1.0",
  "description": "Policy-gated, auditable execution worker for AIJOBS bounties",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": { "aijobs-worker": "./dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "engines": { "node": ">=20" },
  "devDependencies": { "@types/node": "^22.0.0", "tsup": "^8.3.0", "tsx": "^4.19.0", "typescript": "^5.6.0" },
  "license": "MIT"
}
